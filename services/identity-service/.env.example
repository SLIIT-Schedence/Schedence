# Identity Service settings. PLACEHOLDERS ONLY.
# By default the service reads the repository-root .env (see ../../.env.example).
# A services/identity-service/.env REPLACES the root .env when running from that folder (files are not merged),
# so it must then contain every required variable (DATABASE_URL, AWS_REGION, COGNITO_*, ...).

DB_APPLICATION_NAME=identity-service
# AWS_PROFILE=schedence-identity
# COGNITO_DEVTOOLS_CLIENT_ID=exampledevtoolsclientid000
# RATE_LIMIT_WRITES_PER_MINUTE=60
