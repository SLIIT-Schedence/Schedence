# Academic Data Service settings. PLACEHOLDERS ONLY.
# By default the service reads the repository-root .env (see ../../.env.example).
# A services/academic-data-service/.env REPLACES the root .env when running from that folder (files are not merged),
# so it must then contain every required variable (DATABASE_URL, AWS_REGION, COGNITO_*, ...).

DB_APPLICATION_NAME=academic-data-service
IDENTITY_SERVICE_URL=http://localhost:8001
IDENTITY_PERMISSIONS_CACHE_SECONDS=15
INSTITUTION_TIMEZONE=Asia/Colombo
