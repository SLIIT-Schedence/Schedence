# Schedence environment template - PLACEHOLDERS ONLY, never real values.
# Copy to .env in this folder (git-ignored) and fill in real values there:
#   if (-not (Test-Path .env)) { Copy-Item .env.example .env }
# A service may also keep its own services/<name>/.env (nearest .env wins).
# Syntax is KEY=value: an equals sign, no spaces around it.

# ---------------------------------------------------------------------------
# Database (packages/db-core) - see "Database infrastructure" in README.md
# ---------------------------------------------------------------------------

# development | testing | production
APP_ENV=development

# Neon POOLED connection string (host contains "-pooler"). Used by services at runtime.
# Neon Console -> Connect -> enable "Connection pooling" -> copy.
# postgresql:// is accepted and adapted to postgresql+psycopg:// automatically.
DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE-123456-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require

# Optional: Neon DIRECT connection string (same host without "-pooler").
# Used for migrations and admin tasks; falls back to DATABASE_URL when unset.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE-123456.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require

# Client-side pool, per process: at most DB_POOL_SIZE + DB_MAX_OVERFLOW connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Seconds to wait for a free pooled connection.
DB_POOL_TIMEOUT=30
# Seconds before a pooled connection is replaced (-1 = never).
DB_POOL_RECYCLE=1800
# Test each pooled connection before use (recommended: Neon closes idle connections on scale-to-zero).
DB_POOL_PRE_PING=true
# Seconds to wait when opening a new connection.
DB_CONNECT_TIMEOUT=10
# Log every SQL statement. Must be false in production.
DB_ECHO=false

# Optional: name shown in pg_stat_activity, e.g. identity-service.
# DB_APPLICATION_NAME=identity-service
# Optional: disable client-side pooling (defaults to true when APP_ENV=testing).
# DB_USE_NULL_POOL=false
# Optional: set true if the pooler reports "prepared statement ... does not exist".
# DB_DISABLE_PREPARED_STATEMENTS=false

# Optional: point every Schedence tool at a specific env file instead of searching for .env.
# SCHEDENCE_ENV_FILE=C:\path\to\service.env
