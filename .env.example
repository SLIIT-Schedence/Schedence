# Schedence environment template - PLACEHOLDERS ONLY, never real values.
# Copy to .env in this folder (git-ignored) and fill in real values there:
#   if (-not (Test-Path .env)) { Copy-Item .env.example .env }
# A service may also keep its own services/<name>/.env (nearest .env wins).
# Syntax is KEY=value: an equals sign, no spaces around it.

# ---------------------------------------------------------------------------
# Database (packages/db-core) - see "Database infrastructure" in README.md
# ---------------------------------------------------------------------------

# development | testing | production
APP_ENV=development

# Neon POOLED connection string (host contains "-pooler"). Used by services at runtime.
# Neon Console -> Connect -> enable "Connection pooling" -> copy.
# postgresql:// is accepted and adapted to postgresql+psycopg:// automatically.
DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE-123456-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require

# Optional: Neon DIRECT connection string (same host without "-pooler").
# Used for migrations and admin tasks; falls back to DATABASE_URL when unset.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE-123456.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require

# Client-side pool, per process: at most DB_POOL_SIZE + DB_MAX_OVERFLOW connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Seconds to wait for a free pooled connection.
DB_POOL_TIMEOUT=30
# Seconds before a pooled connection is replaced (-1 = never).
DB_POOL_RECYCLE=1800
# Test each pooled connection before use (recommended: Neon closes idle connections on scale-to-zero).
DB_POOL_PRE_PING=true
# Seconds to wait when opening a new connection.
DB_CONNECT_TIMEOUT=10
# Log every SQL statement. Must be false in production.
DB_ECHO=false

# Optional: name shown in pg_stat_activity, e.g. identity-service.
# DB_APPLICATION_NAME=identity-service
# Optional: disable client-side pooling (defaults to true when APP_ENV=testing).
# DB_USE_NULL_POOL=false
# Optional: set true if the pooler reports "prepared statement ... does not exist".
# DB_DISABLE_PREPARED_STATEMENTS=false

# Optional: point every Schedence tool at a specific env file instead of searching for .env.
# SCHEDENCE_ENV_FILE=C:\path\to\service.env

# ---------------------------------------------------------------------------
# AWS Cognito (packages/auth-core, identity-service, academic-data-service)
# See services/identity-service/README.md. IDs below are identifiers, not secrets.
# ---------------------------------------------------------------------------

# Region of the user pool; must equal the prefix of COGNITO_USER_POOL_ID.
AWS_REGION=ap-south-1
# Cognito console -> User pool -> Overview -> User pool ID
COGNITO_USER_POOL_ID=ap-south-1_EXAMPLE123
# App clients -> Schedence-Web -> Client ID (the web app's client; tokens must carry this client_id)
COGNITO_APP_CLIENT_ID=exampleclientid1234567890
# Branding -> Domain (https origin, no path)
COGNITO_DOMAIN=https://schedence-example.auth.ap-south-1.amazoncognito.com
# Optional. Derived from AWS_REGION + COGNITO_USER_POOL_ID; if set it must match exactly.
# COGNITO_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_EXAMPLE123
# Optional public (SPA) client for Swagger UI / Postman; ignored when APP_ENV=production.
# COGNITO_DEVTOOLS_CLIENT_ID=exampledevtoolsclientid000
# Optional: space-separated scopes every access token must carry.
# COGNITO_REQUIRED_SCOPES=

# AWS CLI profile used by boto3 for Cognito admin calls (a profile NAME, not a key).
# Prefer IAM Identity Center: aws configure sso --profile schedence-identity ; aws sso login --profile schedence-identity
# Never put AWS access keys or the Schedence-Web client secret in this file.
AWS_PROFILE=schedence-identity

# Browser origin(s) allowed by CORS (comma-separated, no wildcards).
FRONTEND_URL=http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Academic Data Service
# ---------------------------------------------------------------------------
# IDENTITY_SERVICE_URL=http://localhost:8001
# IDENTITY_PERMISSIONS_CACHE_SECONDS=15
# INSTITUTION_TIMEZONE=Asia/Colombo

# ---------------------------------------------------------------------------
# Teaching Service: shared own-schema credentials, HTTP owner reads
# ---------------------------------------------------------------------------
# Supply the restricted Teaching runtime login in the SAME shared .env.
# Do not use neondb_owner / a BYPASSRLS role for Teaching request handling.
TEACHING_DATABASE_URL=postgresql://schedence_teaching_runtime:PASSWORD@ep-EXAMPLE-123456-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
TEACHING_DIRECT_DATABASE_URL=postgresql://schedence_teaching_runtime:PASSWORD@ep-EXAMPLE-123456.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# ENABLED works in development, testing and production. DEVELOPMENT is a legacy
# alias; DISABLED turns off only the readiness endpoints. No solver is started.
TEACHING_GENERATION_READINESS=ENABLED
TEACHING_GENERATION_MODE=DISABLED
TEACHING_FORM_SENDING_ENABLED=true
TEACHING_FORMS_PUBLIC_ORIGIN=http://localhost:3000
ACADEMIC_SERVICE_URL=http://localhost:8002
# Resource currently has no HTTP runtime. Its owner must supply the API below.
RESOURCE_SERVICE_URL=http://localhost:8006
TEACHING_OWNER_TIMEOUT_SECONDS=10
# Proposed owner integration routes: not implemented by Teaching or auto-created.
# Missing routes return a feature-specific 503; timetables/forms keep working.
TEACHING_ACADEMIC_INPUTS_PATH=/api/v1/academic/teaching-inputs
TEACHING_RESOURCE_INPUTS_PATH=/api/v1/resource/teaching-inputs
TEACHING_FORM_RECIPIENTS_PATH=/api/v1/academic/form-recipients
TEACHING_FORM_SELF_PATH=/api/v1/academic/form-recipients/me
# Normal readiness/sending need no TEACHING_DATABASE_ENV_FILE, ACADEMIC_ or
# RESOURCE_ database credentials, Neon project/branch pins, or local-data/ files.
