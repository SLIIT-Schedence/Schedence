# Schedence web app - PLACEHOLDERS ONLY, never real values.
# Copy to .env.local in this folder (git-ignored) and fill in real values there:
#   if (-not (Test-Path .env.local)) { Copy-Item .env.example .env.local }
# Everything here is read on the server only. Never add a NEXT_PUBLIC_ prefix.

# Encrypts the session cookie. Generate a value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Public origin of this app, no trailing slash.
AUTH_URL=http://localhost:3000

# Cognito app client "Schedence-Web" (Traditional web application). The sign-in form on /login calls the
# user pool API from the server, so the app client must allow ALLOW_USER_PASSWORD_AUTH and
# ALLOW_REFRESH_TOKEN_AUTH under Authentication flows. Managed login and its callback URLs are not used.
AUTH_COGNITO_ID=exampleclientid1234567890
# Client secret of Schedence-Web. Lives only in .env.local, never in the root .env.
AUTH_COGNITO_SECRET=
# https://cognito-idp.<region>.amazonaws.com/<user pool id>. The region is read from it.
AUTH_COGNITO_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_EXAMPLE123

# identity-service base URL, called from the Next.js server only.
IDENTITY_SERVICE_URL=http://localhost:8001

# academic-data-service base URL, called from the Next.js server only (Academic Admin console).
ACADEMIC_SERVICE_URL=http://localhost:8002

# teaching-service base URL, called from the Next.js server only (Academic Admin teaching timetables).
TEACHING_SERVICE_URL=http://localhost:8004
